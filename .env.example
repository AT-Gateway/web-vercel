# Frontend + backend on the same Vercel URL.
# Keep this empty in Vercel so browser calls go to /api on the same domain.
NEXT_PUBLIC_API_BASE_URL=

# Public deployed URL. Recommended for Telegram webhook setup on Vercel.
APP_PUBLIC_URL=https://your-domain.vercel.app

# Demo mode. Enter this code in the OTP screen to open the seeded demo database.
NEXT_PUBLIC_DEMO_MODE_CODE=000000
DEMO_MODE_ENABLED=true
DEMO_MODE_CODE=000000

# Real database mode. Required when you want the Android gateway, Telegram links, push subscriptions, and real data.
# Use a hosted Postgres database such as Neon, Supabase, Railway, or a Vercel Marketplace Postgres integration.
DATABASE_URL=
PG_POOL_MAX=3
# Set PGSSLMODE=disable only for localhost/local Docker Postgres.
# PGSSLMODE=disable

# Admin key for Android gateway requests. Replace with a strong random secret in production.
API_KEY=change-me-before-production

# Pairing / outbox settings.
JOIN_CODE_TTL_MS=600000
CLAIM_TTL_MS=60000
DEFAULT_GATEWAY_DEVICE_ID=note8

# Web Push (optional). Leave empty to disable push notifications.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Telegram bot. On Vercel, use webhook mode, not polling.
TELEGRAM_ENABLED=true
TELEGRAM_MODE=webhook
TELEGRAM_BOT_TOKEN=
# Optional but recommended: your bot username without @, used to show an “Open Telegram bot” link in the app.
TELEGRAM_BOT_USERNAME=
# Strong random string used in /api/telegram/webhook/<secret>.
TELEGRAM_WEBHOOK_SECRET=
# Optional security allow-list. Leave empty to allow only chats linked with an app-generated code.
TELEGRAM_ALLOWED_CHAT_IDS=
# Backward-compatible single chat id. Prefer in-app linking instead.
TELEGRAM_CHAT_ID=
TELEGRAM_LINK_CODE_TTL_MS=600000
